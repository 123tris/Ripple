<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="Ripple.uss" />
    <ui:VisualElement class="ripple-window">
        <uie:Toolbar>
            <uie:ToolbarSearchField name="search" class="ripple-grow" />
            <uie:ToolbarButton name="clear" text="Clear Log" />
        </uie:Toolbar>
        <ui:TwoPaneSplitView fixed-pane-initial-dimension="200">
            <ui:TreeView name="assets" class="ripple-assets" fixed-item-height="18" />
            <ui:VisualElement>
                <ui:MultiColumnListView name="log" class="ripple-grow" show-alternating-row-backgrounds="ContentOnly" fixed-item-height="20">
                    <ui:Columns>
                        <ui:Column name="time" title="Time" width="90" />
                        <ui:Column name="asset" title="Asset" width="160" />
                        <ui:Column name="caller" title="Raised By" stretchable="true" min-width="80" />
                        <ui:Column name="value" title="Value" stretchable="true" min-width="60" />
                    </ui:Columns>
                </ui:MultiColumnListView>
                <ui:ScrollView name="inspector" class="ripple-inspector ripple-grow" />
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
