<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Template name="CallerCell" src="Cells/CallerCell.uxml" />
    <ui:Template name="CountCell" src="Cells/CountCell.uxml" />
    <ui:Template name="ValueCell" src="Cells/ValueCell.uxml" />
    <ui:Template name="TimeCell" src="Cells/TimeCell.uxml" />
    <ui:Template name="KindCell" src="Cells/KindCell.uxml" />
    <ui:Template name="NameCell" src="Cells/NameCell.uxml" />
    <ui:Style src="Ripple.uss" />
    <ui:Foldout name="debug" text="Debug" value="false" view-data-key="ripple-debug" class="ripple-debug ripple-debug--history ripple-debug--listeners">
        <ui:MultiColumnListView name="history" binding-source-selection-mode="AutoAssign" show-border="true" show-alternating-row-backgrounds="ContentOnly" fixed-item-height="20" class="ripple-table ripple-debug__history">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="History" binding-mode="ToTargetOnce" />
            </Bindings>
            <ui:Columns>
                <ui:Column name="caller" title="Raised By" stretchable="true" min-width="80" cell-template="Cells/CallerCell.uxml" />
                <ui:Column name="count" title="Count" width="50" cell-template="Cells/CountCell.uxml" />
                <ui:Column name="value" title="Last Value" stretchable="true" min-width="60" cell-template="Cells/ValueCell.uxml" />
                <ui:Column name="time" title="At" width="86" cell-template="Cells/TimeCell.uxml" />
            </ui:Columns>
        </ui:MultiColumnListView>
        <ui:ScrollView name="trace" class="ripple-debug__trace" />
        <ui:MultiColumnListView name="listeners" binding-source-selection-mode="AutoAssign" show-border="true" show-alternating-row-backgrounds="ContentOnly" fixed-item-height="20" class="ripple-table ripple-debug__listeners">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Listeners" binding-mode="ToTargetOnce" />
            </Bindings>
            <ui:Columns>
                <ui:Column name="kind" title="Where" width="80" cell-template="Cells/KindCell.uxml" />
                <ui:Column name="name" title="Listener" stretchable="true" min-width="80" cell-template="Cells/NameCell.uxml" />
            </ui:Columns>
        </ui:MultiColumnListView>
        <ui:VisualElement class="ripple-row">
            <ui:Button name="findListeners" text="Find Listeners" tooltip="List what listens to this asset: responses wired on it, code that subscribed with AddListener, and listener components in the open scenes." />
            <ui:Button name="searchPrefabs" text="Include Prefabs" tooltip="Also search every prefab in the project. Slow in a large project." />
        </ui:VisualElement>
        <ui:Toggle label="Disable Logging" binding-path="disableLogging" tooltip="Keep this asset out of the Ripple Debugger log." class="unity-base-field__aligned" />
        <ui:Toggle label="Disable Stack Trace" binding-path="disableStackTrace" tooltip="Skip capturing the call stack. Callers are then named only when they pass themselves as the sender." class="unity-base-field__aligned" />
        <ui:VisualElement name="extra" content-container="extra" />
    </ui:Foldout>
</ui:UXML>
