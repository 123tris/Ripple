<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:ripple="Ripple" editor-extension-mode="True">
    <ui:Template name="Debug" src="Debug.uxml" />
    <ui:Style src="Ripple.uss" />
    <ui:VisualElement class="ripple-editor ripple-list">
        <ui:TextField binding-path="_developerNotes" multiline="true" placeholder-text="Notes" class="ripple-notes" />
        <ui:ListView name="initial" binding-path="_initialValues" header-title="Initial Values" show-foldout-header="true" show-add-remove-footer="true" reorderable="true" reorder-mode="Animated" show-border="true" virtualization-method="DynamicHeight" class="ripple-list__initial" />
        <ui:VisualElement class="ripple-list__live">
            <ui:VisualElement class="ripple-row">
                <ui:Label text="Values" class="ripple-grow ripple-list__heading" />
                <ui:Button name="reset" text="Reset" tooltip="Set the list back to its initial values." />
            </ui:VisualElement>
            <ui:ListView name="values" show-border="true" fixed-item-height="20" class="ripple-table" />
        </ui:VisualElement>
        <ripple:SignalField label="On Item Added" binding-path="OnItemAdded" />
        <ripple:SignalField label="On Item Removed" binding-path="OnItemRemoved" />
        <ui:Instance template="Debug" />
    </ui:VisualElement>
</ui:UXML>
