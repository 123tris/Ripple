<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Template name="TypeRow" src="Rows/TypeRow.uxml" />
    <ui:Style src="Ripple.uss" />
    <ui:VisualElement class="ripple-editor ripple-generator">
        <uie:ToolbarSearchField name="search" placeholder-text="Type to generate for, for example Quaternion" />
        <ui:ListView name="matches" item-template="Rows/TypeRow.uxml" binding-source-selection-mode="AutoAssign" show-border="true" fixed-item-height="18" class="ripple-generator__types">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Matches" binding-mode="ToTargetOnce" />
            </Bindings>
        </ui:ListView>
        <ui:VisualElement class="ripple-row">
            <ui:TextField label="Folder" binding-path="folder" class="ripple-grow unity-base-field__aligned" />
            <ui:Button name="browse" text="Browse" />
        </ui:VisualElement>
        <ui:TextField label="Namespace" binding-path="namespace" class="unity-base-field__aligned" />
        <uie:EnumFlagsField label="Generate" binding-path="parts" class="unity-base-field__aligned" />
        <ui:Button name="generate" text="Generate" class="ripple-generator__generate" />
    </ui:VisualElement>
</ui:UXML>
